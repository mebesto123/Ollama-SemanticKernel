@page "/chat"
@using Ollama.SemanticKernel.Models
@inject ISnackbar Snackbar


<h3>Chat</h3>

@{
    var orderedGroups = messages
        .OrderBy(m => m.Time)
        .GroupBy(m => m.Name)
        .ToList();

    for (int i = 0; i < orderedGroups.Count; i++)
    {
        var group = orderedGroups[i];
        var position = group.First().Name == "agent" ? ChatBubblePosition.Start : ChatBubblePosition.End;

        @foreach (var message in group.OrderBy(m => m.Time))
        {
            <MudChat ChatPosition="@position">
                <MudChatHeader Time="@message.Time" />
                    <MudChatBubble>
                        @message.Text
                    </MudChatBubble>
            </MudChat>
        }
    }
}

<br />

<MudTextField @bind-Value="TextValue" Immediate=true Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Send" AdornmentColor="Color.Primary"
KeyDownPreventDefault="_preventDefault" TextUpdateSuppression=false OnAdornmentClick="QueryAgent" OnKeyDown="HandleKeyDown"></MudTextField>


@code {
    bool _preventDefault;
    private List<Message> messages = new();
    private string TextValue { get; set; }

    protected override void OnInitialized()
    {
        messages.Add(new Message("agent", "Hello, I am chat bot. Please try talking to me.", DateTime.Now.ToString("f")));
    }

    private void QueryAgent()
    {
        messages.Add(new Message("user", TextValue, DateTime.Now.ToString("f")));
        TextValue = "";
    }

    protected void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _preventDefault = true;
            QueryAgent();
        }
        else
        {
            _preventDefault = false;
        }
    }
}
